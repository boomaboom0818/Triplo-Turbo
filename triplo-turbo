#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")" && pwd)
cd -- "$root"

if [[ ${1:-} == setup && $# == 1 ]]; then
  url=${TRIPLO_TURBO_ENGINE_URL:-}
  if [[ -n $url ]]; then
    git config --local submodule.engine.url "$url"
  elif [[ -f engine/Cargo.toml ]] && ! git config --local --get submodule.engine.url >/dev/null; then
    # Reuse the private URL from an existing engine checkout after a launcher upgrade.
    git config --local submodule.engine.url "$(git -C engine remote get-url origin)"
  fi
  if ! git config --local --get submodule.engine.url >/dev/null; then
    echo 'Set TRIPLO_TURBO_ENGINE_URL to the authorized private engine Git URL, then run setup again.' >&2
    exit 1
  fi
  exec git submodule update --init --checkout -- engine
fi

# Local build views and live hand histories should not be readable by other users.
umask 077
manifest=$(python3 "$root/scripts/prepare-engine.py" "$root")
build_dir="$root/target/triplo-turbo"
export TRIPLO_TURBO_V4_MODEL_DIR=${TRIPLO_TURBO_V4_MODEL_DIR:-"${manifest%/*}/models/v4"}

if [[ ${1:-} == test ]]; then
  shift
  exec "$root/scripts/cargo" test --locked --release --manifest-path "$manifest" \
    --target-dir "$build_dir" "$@"
fi

if [[ ${1:-} == play ]]; then
  if [[ -n ${OPENPOKER_KEY_FILE:-} && -z ${OPENPOKER_API_KEY:-} && -z ${OPEN_POKER_API_KEY:-} ]]; then
    key=$(<"$OPENPOKER_KEY_FILE")
    export OPENPOKER_API_KEY=${key%$'\r'}
    [[ -n $OPENPOKER_API_KEY ]] || { echo 'Open Poker key file is empty' >&2; exit 1; }
  fi
fi

"$root/scripts/cargo" build --quiet --locked --release --manifest-path "$manifest" \
  --target-dir "$build_dir" --bin triplo-turbo
exec "$build_dir/release/triplo-turbo" "$@"
