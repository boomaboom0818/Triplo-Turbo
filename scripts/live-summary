#!/usr/bin/env python3
"""Read Turbo's local live-service journal; exclude other bots and shadow decisions."""
import argparse
import collections
import json
import subprocess

p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--since',default='12 hours ago')
p.add_argument('--hand-ids',action='store_true',help='print one observed result hand ID per line')
a=p.parse_args()
hands={};counts=collections.Counter();latencies=[]
with subprocess.Popen(['journalctl','--user','-u','triplo-turbo-live.service','--since',a.since,'-o','cat'],
                      stdout=subprocess.PIPE,text=True) as proc:
    for line in proc.stdout:
        try: row=json.loads(line)
        except ValueError: continue
        if not isinstance(row,dict) or row.get('v')!=1: continue
        kind=row.get('event');d=row.get('data',{});counts[kind]+=1
        if kind=='decision': latencies.append(d['decision_us'])
        if kind=='hand_result' and d.get('hand') and d.get('seat') is not None and isinstance(d.get('winner_seats'),list):
            if str(d['seat']) in (d.get('final_stacks') or {}):
                hands[d['hand']]=d['seat'] in d['winner_seats']
    if proc.wait(): raise SystemExit('journalctl failed')
latencies.sort()
if a.hand_ids:
    for hand in hands:print(hand)
    raise SystemExit(0)
print(json.dumps(dict(observed_hands=len(hands),won=sum(hands.values()),
                      observed_win_pct=100*sum(hands.values())/len(hands) if hands else None,
                      decisions=counts['decision'],acks=counts['ack'],rejections=counts['rejected'],
                      p99_decision_us=latencies[(len(latencies)-1)*99//100] if latencies else None),indent=2))
