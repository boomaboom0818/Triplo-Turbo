#!/usr/bin/env bash
# Install a per-user Linux service from a built release. No root required.
set -euo pipefail
mode=${1:-}
source_file=${2:-}
if [[ ! $mode =~ ^(live|shadow)$ || ! -f $source_file ]]; then
  echo 'Usage: scripts/install-service shadow /absolute/player-trace.jsonl | live /absolute/self-host.key' >&2
  exit 2
fi
source_file=$(realpath "$source_file")
case "$source_file" in *$'\n'*|*'"'*|*'%'*|*'\'*) echo 'Unsupported character in path' >&2; exit 2;; esac
root=$(cd "$(dirname "$0")/.." && pwd)
binary="$root/target/release/triplo-turbo"
[[ -x $binary ]] || { echo 'Build first: cargo build --release --locked' >&2; exit 1; }
unit="triplo-turbo-$mode.service"
if [[ $mode == live ]] && systemctl --user is-active --quiet triplo-equity-live.service; then
  echo 'triplo-equity-live.service is active. Stop it at the intended handover before starting Turbo with the same key.' >&2
  exit 1
fi
bindir="$HOME/.local/lib/triplo-turbo/$mode"
units="$HOME/.config/systemd/user"
install -d "$bindir" "$units"
install -m 755 "$binary" "$bindir/triplo-turbo.new"
mv -f "$bindir/triplo-turbo.new" "$bindir/triplo-turbo"
if [[ $mode == live ]]; then
  opts="LoadCredential=openpoker:$source_file"
  args=live
else
  opts=''; args="shadow \"$source_file\""
fi
cat > "$units/$unit" <<EOF
[Unit]
Description=Triplo Turbo poker ($mode)
After=network-online.target

[Service]
Type=simple
$opts
ExecStart="%h/.local/lib/triplo-turbo/$mode/triplo-turbo" $args
Restart=on-failure
RestartSec=12s
TimeoutStopSec=10s
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
EOF
systemctl --user daemon-reload
systemctl --user enable "$unit"
systemctl --user restart "$unit"
systemctl --user is-active "$unit"
